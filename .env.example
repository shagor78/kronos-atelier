# ============================================================================
# KRONOS ATELIER — PRODUCTION E-COMMERCE PLATFORM ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and populate with environment-specific values.
# NEVER commit a populated .env file or real credentials to version control.

# Application Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DATABASE_URL=./database/ecommerce.sqlite
DB_BACKUP_DIR=./database/backups

# Authentication & Security Secrets (Replace with strong 64-byte hex in production)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_WITH_CRYPTOGRAPHIC_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
CSRF_SECRET=CHANGE_ME_IN_PRODUCTION_CSRF_SECRET

# SSL / TLS Configuration (Never commit real certificates or keys to Git)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/app/fullchain.pem
SSL_KEY_PATH=/etc/ssl/private/app/privkey.pem

# AWS & Cloud Infrastructure
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_EC2_HOST=
AWS_EC2_USER=ecommerce

# Payment Gateway Integration
PAYMENT_PROVIDER=stripe_compatible
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notification Channels (Deployment & Order Alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=devops@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMS_API_KEY=
SMS_RECIPIENT=

# Optional AI Studio Runtime Key
GEMINI_API_KEY=
