[Unit]
Description=Kronos Atelier Production E-Commerce Platform
After=network.target

[Service]
Type=simple
User=ecommerce
Group=ecommerce
WorkingDirectory=/opt/kronos-ecommerce
EnvironmentFile=/opt/kronos-ecommerce/.env
ExecStart=/usr/bin/npx tsx server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
